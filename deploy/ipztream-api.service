[Unit]
Description=IPZStream API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ipztream
ExecStart=/usr/bin/node /opt/ipztream/server/index.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=IPZTREAM_API_HOST=127.0.0.1
Environment=IPZTREAM_API_PORT=3100

[Install]
WantedBy=multi-user.target
